@model ExamSessionCreateViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Tạo phiên thi";
    var defaultStart = DateTime.Today.AddDays(1).AddHours(9)
        .ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Kỳ thi</span>
        <h1 class="page-title">Tạo phiên thi</h1>
        <p class="page-subtitle">Thiết lập lịch từng lượt thi và yêu cầu phân bổ câu hỏi không lặp.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</div>

<div asp-validation-summary="All" class="alert alert-danger"></div>

@if (!Model.OptionsLoaded)
{
    <div class="alert alert-warning" role="alert">
        <strong>Chưa thể tải dữ liệu lựa chọn.</strong>
        <span>@Model.OptionsError</span>
    </div>
}

<div class="content-card mb-3">
    <h2 class="h6 text-uppercase text-secondary">Dữ liệu cần có</h2>
    <div class="row g-2 mt-1">
        <div class="col-md-4">
            <div class="d-flex align-items-center justify-content-between gap-2 p-3 bg-light rounded-3">
                <span>Giảng viên: <strong>@Model.InstructorOptions.Count</strong></span>
                <a asp-controller="Instructors" asp-action="@(Model.InstructorOptions.Count == 0 ? "Create" : "Index")">@(Model.InstructorOptions.Count == 0 ? "Thêm ngay" : "Quản lý")</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-center justify-content-between gap-2 p-3 bg-light rounded-3">
                <span>Môn học: <strong>@Model.SubjectOptions.Count</strong></span>
                <a asp-controller="Subjects" asp-action="@(Model.SubjectOptions.Count == 0 ? "Create" : "Index")">@(Model.SubjectOptions.Count == 0 ? "Thêm ngay" : "Quản lý")</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-center justify-content-between gap-2 p-3 bg-light rounded-3">
                <span>Sinh viên: <strong>@Model.StudentOptions.Count</strong></span>
                <a asp-controller="Students" asp-action="@(Model.StudentOptions.Count == 0 ? "Create" : "Index")">@(Model.StudentOptions.Count == 0 ? "Thêm ngay" : "Quản lý")</a>
            </div>
        </div>
    </div>
</div>

@if (Model.CanCreate)
{
    <form id="exam-session-form" class="content-card form-card mx-auto" method="post" asp-action="Create" asp-antiforgery="true" novalidate>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="InstructorId" class="form-label">Giảng viên phụ trách</label>
                <select asp-for="InstructorId" asp-items="Model.InstructorOptions" class="form-select">
                    <option value="">Chọn giảng viên</option>
                </select>
                <span asp-validation-for="InstructorId" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SubjectId" class="form-label">Môn học</label>
                <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-select">
                    <option value="">Chọn môn học</option>
                </select>
                <span asp-validation-for="SubjectId" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Date" class="form-label">Ngày thi</label>
                <input asp-for="Date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="Date" class="field-validation-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Name" class="form-label">Tên phiên thi</label>
                <input asp-for="Name" class="form-control" maxlength="200" placeholder="Kiểm tra giữa kỳ môn C# nâng cao" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div>
                <h2 class="h5 mb-1">Lịch từng lượt thi</h2>
                <p class="text-secondary small mb-0">Thời gian nhập theo @TimeZoneInfo.Local.Id; thời gian kết thúc được tính tự động từ giờ bắt đầu cộng thời lượng.</p>
            </div>
            <button id="add-participant" class="btn btn-outline-primary" type="button">Thêm lượt thi</button>
        </div>

        <div class="alert alert-info">
            Mỗi sinh viên xuất hiện đúng một lần. Hệ thống yêu cầu đủ số câu Core và chỉ thêm Deep trong giới hạn cho phép.
        </div>

        <div id="participant-rows" class="participant-list">
            @if (Model.Participants != null)
            {
                for (var index = 0; index < Model.Participants.Count; index++)
                {
                    <div class="participant-row" data-participant-row>
                        <div class="participant-heading">
                            <span class="participant-number" data-participant-number>Lượt thi @(index + 1)</span>
                            <button class="btn btn-sm btn-outline-danger" type="button" data-remove-participant aria-label="Xóa lượt thi @(index + 1)">Xóa dòng</button>
                        </div>
                        <div class="row g-3">
                            <div class="col-xl-5">
                                <label asp-for="Participants[index].StudentId" class="form-label">Sinh viên</label>
                                <select asp-for="Participants[index].StudentId" asp-items="Model.StudentOptions" class="form-select" data-field="StudentId">
                                    <option value="">Chọn sinh viên</option>
                                </select>
                                <span asp-validation-for="Participants[index].StudentId" class="field-validation-error"></span>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <label asp-for="Participants[index].StartTime" class="form-label">Bắt đầu</label>
                                <input asp-for="Participants[index].StartTime" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" data-field="StartTime" />
                                <span asp-validation-for="Participants[index].StartTime" class="field-validation-error"></span>
                            </div>
                            <div class="col-sm-6 col-xl-2">
                                <label asp-for="Participants[index].DurationMinutes" class="form-label">Phút</label>
                                <input asp-for="Participants[index].DurationMinutes" class="form-control" min="1" max="1440" data-field="DurationMinutes" />
                                <span asp-validation-for="Participants[index].DurationMinutes" class="field-validation-error"></span>
                            </div>
                            <div class="col-sm-6 col-xl-1">
                                <label asp-for="Participants[index].RequestedCoreCount" class="form-label">Core</label>
                                <input asp-for="Participants[index].RequestedCoreCount" class="form-control" min="1" max="100" data-field="RequestedCoreCount" />
                                <span asp-validation-for="Participants[index].RequestedCoreCount" class="field-validation-error"></span>
                            </div>
                            <div class="col-sm-6 col-xl-1">
                                <label asp-for="Participants[index].MaximumDeepCount" class="form-label">Deep tối đa</label>
                                <input asp-for="Participants[index].MaximumDeepCount" class="form-control" min="0" max="100" data-field="MaximumDeepCount" />
                                <span asp-validation-for="Participants[index].MaximumDeepCount" class="field-validation-error"></span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div id="participant-empty" class="participant-empty" role="alert">Chưa có lượt thi. Hãy thêm ít nhất một dòng trước khi lưu.</div>
        <div id="participant-validation" class="participant-validation" role="alert"></div>

        <div class="form-actions">
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
            <button class="btn btn-primary" type="submit">Tạo và phân bổ đề</button>
        </div>
    </form>
}
else
{
    <div class="content-card empty-state">
        <div class="empty-icon" aria-hidden="true">!</div>
        <h2 class="h5">Chưa đủ dữ liệu để tạo phiên thi</h2>
        <p class="text-secondary">Bổ sung ít nhất một giảng viên, một môn học và một sinh viên, sau đó tải lại trang.</p>
        <a class="btn btn-primary" asp-action="Create">Tải lại lựa chọn</a>
    </div>
}

<template id="participant-template" class="participant-template">
    <div class="participant-row" data-participant-row>
        <div class="participant-heading">
            <span class="participant-number" data-participant-number>Lượt thi mới</span>
            <button class="btn btn-sm btn-outline-danger" type="button" data-remove-participant aria-label="Xóa lượt thi mới">Xóa dòng</button>
        </div>
        <div class="row g-3">
            <div class="col-xl-5">
                <label class="form-label" data-label-for="StudentId">Sinh viên</label>
                <select name="Participants[__INDEX__].StudentId" class="form-select" data-field="StudentId" data-val-required="true" data-val-required-message="Vui lòng chọn sinh viên.">
                    <option value="">Chọn sinh viên</option>
                    @foreach (var option in Model.StudentOptions)
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                </select>
                <span class="field-validation-error" data-valmsg-for="Participants[__INDEX__].StudentId"></span>
            </div>
            <div class="col-sm-6 col-xl-3">
                <label class="form-label" data-label-for="StartTime">Bắt đầu</label>
                <input name="Participants[__INDEX__].StartTime" type="datetime-local" class="form-control" value="@defaultStart" data-field="StartTime" data-val-required="true" data-val-required-message="Vui lòng chọn giờ bắt đầu." />
                <span class="field-validation-error" data-valmsg-for="Participants[__INDEX__].StartTime"></span>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" data-label-for="DurationMinutes">Phút</label>
                <input name="Participants[__INDEX__].DurationMinutes" type="number" class="form-control" value="60" min="1" max="1440" data-field="DurationMinutes" data-val-range="true" data-val-range-min="1" data-val-range-max="1440" data-val-range-message="Thời lượng phải từ 1 đến 1440 phút." />
                <span class="field-validation-error" data-valmsg-for="Participants[__INDEX__].DurationMinutes"></span>
            </div>
            <div class="col-sm-6 col-xl-1">
                <label class="form-label" data-label-for="RequestedCoreCount">Core</label>
                <input name="Participants[__INDEX__].RequestedCoreCount" type="number" class="form-control" value="2" min="1" max="100" data-field="RequestedCoreCount" data-val-range="true" data-val-range-min="1" data-val-range-max="100" data-val-range-message="Số câu Core phải từ 1 đến 100." />
                <span class="field-validation-error" data-valmsg-for="Participants[__INDEX__].RequestedCoreCount"></span>
            </div>
            <div class="col-sm-6 col-xl-1">
                <label class="form-label" data-label-for="MaximumDeepCount">Deep tối đa</label>
                <input name="Participants[__INDEX__].MaximumDeepCount" type="number" class="form-control" value="1" min="0" max="100" data-field="MaximumDeepCount" data-val-range="true" data-val-range-min="0" data-val-range-max="100" data-val-range-message="Số câu Deep tối đa phải từ 0 đến 100." />
                <span class="field-validation-error" data-valmsg-for="Participants[__INDEX__].MaximumDeepCount"></span>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
