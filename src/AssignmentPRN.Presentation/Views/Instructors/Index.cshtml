@model InstructorListViewModel
@{
    ViewData["Title"] = "Giảng viên";
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Danh mục</span>
        <h1 class="page-title">Giảng viên</h1>
        <p class="page-subtitle">Quản lý thông tin liên hệ và người phụ trách các phiên thi.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm giảng viên</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="content-card empty-state">
        <div class="empty-icon" aria-hidden="true">GV</div>
        <h2 class="h5">Chưa có giảng viên</h2>
        <p class="text-secondary">Thêm giảng viên đầu tiên để chuẩn bị cho phiên thi.</p>
        <a class="btn btn-primary" asp-action="Create">Thêm giảng viên</a>
    </div>
}
else
{
    <div class="table-card table-responsive">
        <table class="table align-middle">
            <caption class="visually-hidden">Danh sách giảng viên</caption>
            <thead>
                <tr>
                    <th scope="col">Giảng viên</th>
                    <th scope="col">Email</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <span class="entity-name">@item.Name</span>
                            <span class="entity-meta">Mã #@item.Id</span>
                        </td>
                        <td><a href="mailto:@item.Email">@item.Email</a></td>
                        <td>
                            <div class="action-group">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" asp-antiforgery="true" data-confirm="Xóa giảng viên @item.Name?">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
