@model QuestionFormViewModel
@{
    ViewData["Title"] = "Thêm câu hỏi";
    var hasSubjects = Model.SubjectOptions.Any(option =>
        int.TryParse(option.Value, out var id) && id > 0);
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Ngân hàng câu hỏi</span>
        <h1 class="page-title">Thêm câu hỏi</h1>
        <p class="page-subtitle">Tạo câu Core bắt buộc hoặc câu Deep mở rộng cho một môn học.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-subjectId="@Model.SubjectId">Quay lại</a>
</div>

<div asp-validation-summary="All" class="alert alert-danger"></div>

@if (!hasSubjects)
{
    <div class="content-card empty-state">
        <div class="empty-icon" aria-hidden="true">MH</div>
        <h2 class="h5">Chưa có môn học</h2>
        <p class="text-secondary">Hãy tạo môn học trước khi xây dựng ngân hàng câu hỏi.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary" asp-controller="Subjects" asp-action="Create">Tạo môn học</a>
            <a class="btn btn-outline-secondary" asp-controller="Subjects" asp-action="Index">Danh sách môn học</a>
        </div>
    </div>
}
else
{
    <div class="content-card form-card mx-auto">
        <form method="post" asp-action="Create" asp-antiforgery="true" novalidate>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SubjectId" class="form-label"></label>
                    <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-select"></select>
                    <span asp-validation-for="SubjectId" class="field-validation-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" asp-items="Model.CategoryOptions" class="form-select"></select>
                    <span asp-validation-for="Category" class="field-validation-error"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Difficulty" class="form-label"></label>
                    <select asp-for="Difficulty" asp-items="Model.DifficultyOptions" class="form-select"></select>
                    <span asp-validation-for="Difficulty" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Topic" class="form-label"></label>
                    <input asp-for="Topic" class="form-control" maxlength="200" placeholder="Ví dụ: Vòng lặp và mảng" />
                    <span asp-validation-for="Topic" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="8" maxlength="4000" placeholder="Nhập nội dung đầy đủ của câu hỏi"></textarea>
                    <span asp-validation-for="Content" class="field-validation-error"></span>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-subjectId="@Model.SubjectId">Hủy</a>
                <button class="btn btn-primary" type="submit">Lưu câu hỏi</button>
            </div>
        </form>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
