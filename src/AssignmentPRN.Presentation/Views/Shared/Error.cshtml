@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<section class="content-card text-center error-panel">
    <div class="error-code" aria-hidden="true">!</div>
    <h1 class="h3">Không thể hoàn tất yêu cầu</h1>
    <p class="text-secondary mb-4">Vui lòng thử lại hoặc quay về trang tổng quan.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang tổng quan</a>
</section>
