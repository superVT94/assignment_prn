@model QuestionListViewModel
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Ngân hàng câu hỏi</span>
        <h1 class="page-title">Câu hỏi theo môn học</h1>
        <p class="page-subtitle">Chọn một môn để xem, thêm hoặc cập nhật câu hỏi Core và Deep.</p>
    </div>
    @if (Model.HasSubjects)
    {
        <a class="btn btn-primary" asp-action="Create" asp-route-subjectId="@Model.SubjectId">Thêm câu hỏi</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning" role="status">@Model.LoadError</div>
}

@if (!Model.HasSubjects)
{
    <div class="content-card empty-state">
        <div class="empty-icon" aria-hidden="true">CH</div>
        <h2 class="h5">Cần có môn học trước</h2>
        <p class="text-secondary">Ngân hàng câu hỏi được tách riêng theo từng môn để phân bổ an toàn.</p>
        <a class="btn btn-primary" asp-controller="Subjects" asp-action="Create">Tạo môn học</a>
    </div>
}
else
{
    <form class="filter-bar" method="get" asp-action="Index">
        <div class="flex-grow-1">
            <label asp-for="SubjectId" class="form-label">Môn học</label>
            <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-select"></select>
        </div>
        <button class="btn btn-primary" type="submit">Lọc câu hỏi</button>
    </form>

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
        <div>
            <h2 class="h5 mb-1">@Model.Subject?.Code · @Model.Subject?.Name</h2>
            <span class="text-secondary small">@Model.Questions.Count câu hỏi</span>
        </div>
        <a class="btn btn-primary" asp-action="Create" asp-route-subjectId="@Model.SubjectId">Thêm câu hỏi cho môn này</a>
    </div>

    @if (Model.Questions.Count == 0)
    {
        <div class="content-card empty-state">
            <div class="empty-icon" aria-hidden="true">?</div>
            <h3 class="h5">Môn học chưa có câu hỏi</h3>
            <p class="text-secondary">Thêm câu Core hoặc Deep để chuẩn bị phân bổ đề thi.</p>
            <a class="btn btn-primary" asp-action="Create" asp-route-subjectId="@Model.SubjectId">Thêm câu hỏi</a>
        </div>
    }
    else
    {
        <div class="table-card table-responsive">
            <table class="table align-middle">
                <caption class="visually-hidden">Danh sách câu hỏi của @Model.Subject?.Name</caption>
                <thead>
                    <tr>
                        <th scope="col">Phân loại</th>
                        <th scope="col">Chủ đề</th>
                        <th scope="col">Nội dung</th>
                        <th scope="col">Độ khó</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Questions)
                    {
                        var isCore = !item.IsDeep;
                        <tr>
                            <td>
                                <span class="badge-soft @(isCore ? "badge-core" : "badge-deep")">@item.Category</span>
                            </td>
                            <td><span class="entity-name">@item.Topic</span></td>
                            <td><span class="question-content">@item.Content</span></td>
                            <td>
                                <span class="difficulty" aria-label="@($"Độ khó {item.Difficulty} trên 5")">
                                    @for (var level = 1; level <= 5; level++)
                                    {
                                        <span aria-hidden="true">@(level <= item.Difficulty ? "★" : "☆")</span>
                                    }
                                </span>
                            </td>
                            <td>
                                <div class="action-group">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                    <form method="post" asp-action="Delete" asp-route-id="@item.Id" asp-antiforgery="true" data-confirm="Xóa câu hỏi này?">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
