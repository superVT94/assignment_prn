@{
    ViewData["Title"] = "Tổng quan";
}

<section class="hero-panel mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="eyebrow">Trung tâm đề thi</span>
            <h1>Đồng bộ dữ liệu, kiểm soát đề thi dễ dàng</h1>
            <p class="mb-4">Quản lý giảng viên, môn học, sinh viên, ngân hàng câu hỏi và các phiên thi từ một giao diện duy nhất.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-light btn-lg" asp-controller="ExamSessions" asp-action="Create">Tạo phiên thi</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Questions" asp-action="Index">Quản lý câu hỏi</a>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="hero-note">
                <span class="hero-note-icon" aria-hidden="true">✓</span>
                <div>
                    <strong>Phân bổ tự động</strong>
                    <p>Core bắt buộc, Deep tùy chọn và kiểm tra không lặp câu.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ServiceMessage))
{
    <div class="alert alert-warning shadow-sm" role="status">
        <strong>Một số số liệu chưa tải được.</strong>
        <span>@Model.ServiceMessage</span>
    </div>
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-3">
    <div>
        <span class="eyebrow text-teal">Dữ liệu trực tiếp</span>
        <h2 class="page-title mb-0">Tổng quan hệ thống</h2>
    </div>
    <span class="live-indicator"><span aria-hidden="true"></span>Cập nhật từ dữ liệu hiện có</span>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <a class="metric-card metric-card-teal" asp-controller="Instructors" asp-action="Index">
            <span class="metric-label">Giảng viên</span>
            <strong class="metric-value">@(Model.InstructorCount?.ToString("N0") ?? "—")</strong>
            <span class="metric-action">Quản lý giảng viên</span>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a class="metric-card metric-card-blue" asp-controller="Subjects" asp-action="Index">
            <span class="metric-label">Môn học</span>
            <strong class="metric-value">@(Model.SubjectCount?.ToString("N0") ?? "—")</strong>
            <span class="metric-action">Quản lý môn học</span>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a class="metric-card metric-card-violet" asp-controller="Students" asp-action="Index">
            <span class="metric-label">Sinh viên</span>
            <strong class="metric-value">@(Model.StudentCount?.ToString("N0") ?? "—")</strong>
            <span class="metric-action">Quản lý sinh viên</span>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a class="metric-card metric-card-amber" asp-controller="Questions" asp-action="Index">
            <span class="metric-label">Câu hỏi</span>
            <strong class="metric-value">@(Model.QuestionCount?.ToString("N0") ?? "—")</strong>
            <span class="metric-action">Mở ngân hàng câu hỏi</span>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a class="metric-card metric-card-rose" asp-controller="ExamSessions" asp-action="Index">
            <span class="metric-label">Phiên thi</span>
            <strong class="metric-value">@(Model.SessionCount?.ToString("N0") ?? "—")</strong>
            <span class="metric-action">Xem danh sách phiên thi</span>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="metric-card metric-card-slate">
            <span class="metric-label">Lượt thi</span>
            <strong class="metric-value">@(Model.ParticipantCount?.ToString("N0") ?? "—")</strong>
            <span class="metric-action">Tổng học viên trong các phiên</span>
        </div>
    </div>
</div>

<section class="content-card">
    <div class="row g-4 align-items-center">
        <div class="col-lg-7">
            <span class="eyebrow text-teal">Quy trình nhanh</span>
            <h2 class="h4 mb-3">Chuẩn bị dữ liệu theo thứ tự</h2>
            <div class="workflow-list">
                <div><span>1</span><p><strong>Môn học và giảng viên</strong><small>Tạo dữ liệu nền cho bài thi.</small></p></div>
                <div><span>2</span><p><strong>Sinh viên và câu hỏi</strong><small>Bổ sung danh sách và ngân hàng theo môn.</small></p></div>
                <div><span>3</span><p><strong>Phiên thi</strong><small>Chọn lượt thi, thời lượng và số câu.</small></p></div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="quick-panel">
                <h3 class="h6">Khởi đầu nhanh</h3>
                <a asp-controller="Subjects" asp-action="Create">Thêm môn học <span aria-hidden="true">→</span></a>
                <a asp-controller="Instructors" asp-action="Create">Thêm giảng viên <span aria-hidden="true">→</span></a>
                <a asp-controller="Students" asp-action="Create">Thêm sinh viên <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </div>
</section>
