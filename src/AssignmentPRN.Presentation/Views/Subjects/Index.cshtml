@model SubjectListViewModel
@{
    ViewData["Title"] = "Môn học";
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Danh mục</span>
        <h1 class="page-title">Môn học</h1>
        <p class="page-subtitle">Quản lý mã môn, tên môn và thông tin mô tả dùng cho ngân hàng câu hỏi.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm môn học</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="content-card empty-state">
        <div class="empty-icon" aria-hidden="true">MH</div>
        <h2 class="h5">Chưa có môn học</h2>
        <p class="text-secondary">Tạo môn học trước để xây dựng ngân hàng câu hỏi.</p>
        <a class="btn btn-primary" asp-action="Create">Thêm môn học</a>
    </div>
}
else
{
    <div class="table-card table-responsive">
        <table class="table align-middle">
            <caption class="visually-hidden">Danh sách môn học</caption>
            <thead>
                <tr>
                    <th scope="col">Mã</th>
                    <th scope="col">Môn học</th>
                    <th scope="col">Mô tả</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><span class="badge-soft">@item.Code</span></td>
                        <td>
                            <span class="entity-name">@item.Name</span>
                            <span class="entity-meta">Mã #@item.Id</span>
                        </td>
                        <td>
                            <span class="question-content">@(string.IsNullOrWhiteSpace(item.Description) ? "Chưa có mô tả" : item.Description)</span>
                        </td>
                        <td>
                            <div class="action-group">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" asp-antiforgery="true" data-confirm="Xóa môn học @item.Code - @item.Name?">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
