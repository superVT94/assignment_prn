<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f766e" />
    <title>@ViewData["Title"] · PRN Assignment</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung</a>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Điều hướng chính">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">PRN</span>
                    <span>
                        <strong>Assignment</strong>
                        <small>Quản lý đề thi</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Mở trình đơn">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <NavLink class="nav-link" asp-controller="Home" asp-action="Index">Tổng quan</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" asp-controller="Instructors" asp-action="Index">Giảng viên</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" asp-controller="Subjects" asp-action="Index">Môn học</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" asp-controller="Students" asp-action="Index">Sinh viên</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" asp-controller="Questions" asp-action="Index">Ngân hàng câu hỏi</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link nav-link-cta" asp-controller="ExamSessions" asp-action="Index">Phiên thi</NavLink>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-content">
        @if (TempData["Success"] is string success && !string.IsNullOrWhiteSpace(success))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <span>@success</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <span>@error</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <main id="main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>© @DateTime.Now.Year PRN Assignment</span>
            <span>Hệ thống quản lý và phân bổ đề thi</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
