@model StudentListViewModel
@{
    ViewData["Title"] = "Sinh viên";
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Danh mục</span>
        <h1 class="page-title">Sinh viên</h1>
        <p class="page-subtitle">Quản lý danh sách người tham gia các lượt thi.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm sinh viên</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="content-card empty-state">
        <div class="empty-icon" aria-hidden="true">SV</div>
        <h2 class="h5">Chưa có sinh viên</h2>
        <p class="text-secondary">Thêm sinh viên để chuẩn bị danh sách tham gia phiên thi.</p>
        <a class="btn btn-primary" asp-action="Create">Thêm sinh viên</a>
    </div>
}
else
{
    <div class="table-card table-responsive">
        <table class="table align-middle">
            <caption class="visually-hidden">Danh sách sinh viên</caption>
            <thead>
                <tr>
                    <th scope="col">Mã sinh viên</th>
                    <th scope="col">Họ tên</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><span class="badge-soft">@item.Code</span></td>
                        <td>
                            <span class="entity-name">@item.Name</span>
                            <span class="entity-meta">Mã #@item.Id</span>
                        </td>
                        <td>
                            <div class="action-group">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" asp-antiforgery="true" data-confirm="Xóa sinh viên @item.Code - @item.Name?">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
