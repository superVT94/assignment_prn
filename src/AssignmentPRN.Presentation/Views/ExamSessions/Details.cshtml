@model ExamSessionDetailViewModel
@{
    ViewData["Title"] = Model.Session.Name;
    var session = Model.Session;
    var participants = session.Participants
        .OrderBy(participant => participant.StartTime ?? DateTime.MinValue)
        .ThenBy(participant => participant.StudentCode)
        .ToList();
    var startTimes = participants
        .Where(participant => participant.StartTime.HasValue)
        .Select(participant => participant.StartTime!.Value.ToLocalTime())
        .ToList();
    var endTimes = participants
        .Where(participant => participant.EndTime.HasValue)
        .Select(participant => participant.EndTime!.Value.ToLocalTime())
        .ToList();
    var windowStart = startTimes.Count == 0 ? (DateTime?)null : startTimes.Min();
    var windowEnd = endTimes.Count == 0 ? (DateTime?)null : endTimes.Max();
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Chi tiết kỳ thi</span>
        <h1 class="page-title">@session.Name</h1>
        <p class="page-subtitle">Ngày thi @session.Date.ToString("dd/MM/yyyy") · Mã phiên #@session.Id</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
        <form method="post" asp-action="Delete" asp-route-id="@session.Id" asp-antiforgery="true" data-confirm="Xóa phiên thi @session.Name? Toàn bộ phân bổ câu hỏi sẽ bị xóa.">
            <button class="btn btn-outline-danger" type="submit">Xóa phiên thi</button>
        </form>
    </div>
</div>

<div class="alert guarantee-banner d-flex gap-3 align-items-start" role="status">
    <strong class="fs-5" aria-hidden="true">✓</strong>
    <div>
        <strong>Cam kết không lặp câu</strong>
        <div>Business đã kiểm tra phân bổ không lặp giữa các lượt thi. Mỗi lượt nhận đúng số Core yêu cầu và không vượt quá số Deep tối đa.</div>
    </div>
</div>

@if (session.HasWarnings)
{
    <div class="alert alert-warning" role="alert">
        <strong>Lưu ý khi phân bổ:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var warning in session.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

<div class="content-card mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h5 mb-0">Thông tin phiên thi</h2>
        <span class="badge-soft">@ExamSessionText.Status(session.Status)</span>
    </div>
    <div class="session-summary">
        <div class="summary-item">
            <span>Môn học</span>
            <strong>@session.Subject.Code · @session.Subject.Name</strong>
        </div>
        <div class="summary-item">
            <span>Giảng viên</span>
            <strong>@session.Instructor.Name</strong>
            <small>@session.Instructor.Email</small>
        </div>
        <div class="summary-item">
            <span>Ngày thi</span>
            <strong>@session.Date.ToString("dd/MM/yyyy")</strong>
        </div>
        <div class="summary-item">
            <span>Khung thời gian · @TimeZoneInfo.Local.Id</span>
            <strong>@(windowStart?.ToString("dd/MM/yyyy HH:mm") ?? "—") → @(windowEnd?.ToString("dd/MM/yyyy HH:mm") ?? "—")</strong>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(session.Subject.Description))
    {
        <p class="text-secondary mt-3 mb-0">@session.Subject.Description</p>
    }
</div>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">Lịch thi và đề đã phân bổ</h2>
        <span class="text-secondary small">@participants.Count lượt thi · Thời gian hiển thị theo @TimeZoneInfo.Local.Id</span>
    </div>
</div>

@if (participants.Count == 0)
{
    <div class="content-card empty-state">
        <h3 class="h5">Phiên thi chưa có lượt thi</h3>
    </div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var participant in participants)
        {
            var coreAssignments = participant.Assignments
                .Where(assignment => assignment.Category.ToString().Equals("Core", StringComparison.OrdinalIgnoreCase))
                .OrderBy(assignment => assignment.Order)
                .ToList();
            var deepAssignments = participant.Assignments
                .Where(assignment => assignment.Category.ToString().Equals("Deep", StringComparison.OrdinalIgnoreCase))
                .OrderBy(assignment => assignment.Order)
                .ToList();
            <article class="participant-card">
                <header class="participant-card-header">
                    <div>
                        <span class="entity-name">@participant.StudentName</span>
                        <span class="entity-meta">@participant.StudentCode · Sinh viên #@participant.StudentId</span>
                    </div>
                    <span class="badge-soft">@ExamSessionText.ParticipantStatus(participant.Status)</span>
                </header>
                <div class="participant-card-body">
                    <div class="session-summary mb-3">
                        <div class="summary-item">
                            <span>Cửa sổ lượt thi · @TimeZoneInfo.Local.Id</span>
                            <strong>@(participant.StartTime?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—") → @(participant.EndTime?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</strong>
                        </div>
                        <div class="summary-item">
                            <span>Số câu thực tế / yêu cầu</span>
                            <strong>Core @participant.ActualCoreCount / @participant.RequestedCoreCount</strong>
                            <small>Deep @participant.ActualDeepCount / tối đa @participant.MaximumDeepCount</small>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="assignment-section">
                                <h3 class="h6">Câu Core <span class="badge-soft badge-core">@coreAssignments.Count</span></h3>
                                @if (coreAssignments.Count == 0)
                                {
                                    <p class="text-secondary small mb-0">Không có câu Core.</p>
                                }
                                else
                                {
                                    @foreach (var assignment in coreAssignments)
                                    {
                                        <div class="assignment-item">
                                            <div class="d-flex justify-content-between gap-2 mb-2">
                                                <span class="badge-soft">Câu @assignment.Order</span>
                                                <span class="difficulty" aria-label="@($"Độ khó {assignment.Question.Difficulty} trên 5")">
                                                    @for (var level = 1; level <= 5; level++)
                                                    {
                                                        <span aria-hidden="true">@(level <= assignment.Question.Difficulty ? "★" : "☆")</span>
                                                    }
                                                </span>
                                            </div>
                                            <strong class="d-block mb-1">@assignment.Question.Topic</strong>
                                            <div class="assignment-content">@assignment.Question.Content</div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="assignment-section">
                                <h3 class="h6">Câu Deep <span class="badge-soft badge-deep">@deepAssignments.Count</span></h3>
                                @if (deepAssignments.Count == 0)
                                {
                                    <p class="text-secondary small mb-0">Không có câu Deep.</p>
                                }
                                else
                                {
                                    @foreach (var assignment in deepAssignments)
                                    {
                                        <div class="assignment-item deep">
                                            <div class="d-flex justify-content-between gap-2 mb-2">
                                                <span class="badge-soft">Câu @assignment.Order</span>
                                                <span class="difficulty" aria-label="@($"Độ khó {assignment.Question.Difficulty} trên 5")">
                                                    @for (var level = 1; level <= 5; level++)
                                                    {
                                                        <span aria-hidden="true">@(level <= assignment.Question.Difficulty ? "★" : "☆")</span>
                                                    }
                                                </span>
                                            </div>
                                            <strong class="d-block mb-1">@assignment.Question.Topic</strong>
                                            <div class="assignment-content">@assignment.Question.Content</div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
}
