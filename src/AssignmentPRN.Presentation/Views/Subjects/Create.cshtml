@model SubjectFormViewModel
@{
    ViewData["Title"] = "Thêm môn học";
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Môn học</span>
        <h1 class="page-title">Thêm môn học</h1>
        <p class="page-subtitle">Mã môn hóa được lưu không phân biệt chữ hoa chữ thường.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</div>

<div class="content-card form-card mx-auto">
    <form method="post" asp-action="Create" asp-antiforgery="true" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control text-uppercase" maxlength="20" placeholder="PRN221" />
                <span asp-validation-for="Code" class="field-validation-error"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="200" placeholder="Lập trình C# nâng cao" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5" maxlength="1000" placeholder="Mô tả ngắn về nội dung môn học"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>
        </div>
        <div class="form-actions">
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
            <button class="btn btn-primary" type="submit">Lưu môn học</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
