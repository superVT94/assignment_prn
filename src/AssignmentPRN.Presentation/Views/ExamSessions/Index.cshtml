@model ExamSessionListViewModel
@{
    ViewData["Title"] = "Phiên thi";
}

<div class="page-header">
    <div>
        <span class="eyebrow text-teal">Kỳ thi</span>
        <h1 class="page-title">Phiên thi</h1>
        <p class="page-subtitle">Theo dõi lịch thi, số lượt tham gia và khối lượng câu hỏi đã phân bổ.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tạo phiên thi</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning" role="status">@Model.LoadError</div>
}

@if (Model.Sessions.Count == 0)
{
    <div class="content-card empty-state">
        <div class="empty-icon" aria-hidden="true">KT</div>
        <h2 class="h5">Chưa có phiên thi</h2>
        <p class="text-secondary">Chuẩn bị giảng viên, môn học, sinh viên và câu hỏi để tạo phiên đầu tiên.</p>
        <a class="btn btn-primary" asp-action="Create">Tạo phiên thi</a>
    </div>
}
else
{
    <div class="table-card table-responsive">
        <table class="table align-middle">
            <caption class="visually-hidden">Danh sách phiên thi</caption>
            <thead>
                <tr>
                    <th scope="col">Phiên thi</th>
                    <th scope="col">Môn học</th>
                    <th scope="col">Giảng viên</th>
                    <th scope="col">Lượt thi</th>
                    <th scope="col">Câu hỏi</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Sessions)
                {
                    <tr>
                        <td>
                            <a class="entity-name text-decoration-none" asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                            <span class="entity-meta">@item.Date.ToString("dd/MM/yyyy") · #@item.Id</span>
                        </td>
                        <td>
                            <span class="entity-name">@item.SubjectName</span>
                            <span class="entity-meta">@item.SubjectCode</span>
                        </td>
                        <td>@item.InstructorName</td>
                        <td><span class="badge-soft">@item.ParticipantCount sinh viên</span></td>
                        <td>
                            <span class="entity-name">@(item.CoreQuestionCount + item.DeepQuestionCount) câu</span>
                            <span class="entity-meta">@item.CoreQuestionCount Core · @item.DeepQuestionCount Deep</span>
                        </td>
                        <td><span class="badge-soft">@ExamSessionText.Status(item.Status)</span></td>
                        <td>
                            <div class="action-group">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" asp-antiforgery="true" data-confirm="Xóa phiên thi @item.Name? Toàn bộ phân bổ câu hỏi cũng sẽ bị xóa.">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
